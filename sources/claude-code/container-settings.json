{
  "env": {
    "CLAUDE_PLUGIN_ROOT": "/root/.claude/plugins/cache/ecc/ecc/2.0.0",
    "SAFETY_NET_PLUGIN_ROOT": "/root/.claude/plugins/cache/cc-marketplace/safety-net/1.0.6",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "ECC_HOOK_PROFILE": "standard",
    "ECC_DISABLED_HOOKS": "stop:desktop-notify,pre:edit-write:gateguard-fact-force,pre:observe:continuous-learning,post:observe:continuous-learning,stop:evaluate-session"
  },
  "theme": "dark",
  "includeCoAuthoredBy": false,
  "permissions": { "defaultMode": "auto" },
  "hooks": {
    "PreToolUse": [
      {
        "description": "Safety Net - Block destructive git and filesystem commands",
        "hooks": [
          { "command": "node \"${SAFETY_NET_PLUGIN_ROOT}/dist/bin/cc-safety-net.js\" --claude-code", "timeout": 15, "type": "command" }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [ { "command": "npx block-no-verify@1.1.2", "type": "command" } ],
        "matcher": "Bash"
      }
    ]
  },
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/scripts/statusline.py\" | CLAUDE_SETTINGS_PATH=\"$HOME/.claude/settings.json\" node \"${SAFETY_NET_PLUGIN_ROOT}/dist/bin/cc-safety-net.js\" --statusline"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "safety-net@cc-marketplace": true,
    "ecc@ecc": true
  },
  "enabledMcpjsonServers": ["chrome-devtools", "context7"],
  "extraKnownMarketplaces": {
    "cc-marketplace": { "source": { "source": "github", "repo": "kenryu42/cc-marketplace" } },
    "ecc": { "source": { "source": "git", "url": "https://github.com/affaan-m/everything-claude-code.git" } }
  },
  "language": "chinese",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "max",
  "showClearContextOnPlanAccept": true,
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "terminalProgressBarEnabled": true,
  "todoFeatureEnabled": true,
  "skipAutoPermissionPrompt": true
}
